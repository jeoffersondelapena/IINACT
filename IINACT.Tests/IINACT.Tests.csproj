<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compiled from the plugin's own source so the tests exercise the shipped code. The plugin
		     targets net10.0-windows and cannot be referenced as an assembly on a Mac. -->
		<Compile Include="..\IINACT\ParserWatchdog.cs" Link="ParserWatchdog.cs" />
		<Compile Include="..\IINACT\LogLineTypes.cs" Link="LogLineTypes.cs" />
		<Compile Include="..\IINACT\DiagLog.cs" Link="DiagLog.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
